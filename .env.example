# Singleton — environment variables.
# Copy to `.env.local` (gitignored) and fill in. NEVER commit real secrets.
# `.env.local` is loaded automatically by Next.js, and by the tsx scripts
# (migrate / seed / stress) via dotenv.

# --- AWS / Aurora DSQL (primary region) ---------------------------------------
AWS_REGION=us-east-1
# Cluster endpoint hostname: <clusterId>.dsql.<region>.on.aws
DSQL_CLUSTER_ENDPOINT=

# IAM principal allowed to connect to the cluster. The principal needs
# dsql:DbConnectAdmin (admin DB role) on the cluster ARN. Token auth only —
# there is NO static database password.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DB role to connect as. 'admin' => admin IAM token (dsql:DbConnectAdmin).
# A custom role name => regular IAM token (dsql:DbConnect).
CLUSTER_USER=admin

# --- Admin gate ---------------------------------------------------------------
# Shared secret gating /admin pages and admin APIs (release create, simulate).
ADMIN_TOKEN=

# --- Multi-region (Phase 9) — optional ----------------------------------------
# Second active endpoint of the SAME peered logical database (us-east-2).
# When set, the pool routes to the primary and fails over to this on error.
DSQL_CLUSTER_ENDPOINT_SECONDARY=
AWS_REGION_SECONDARY=us-east-2

# --- Local/dev knobs (optional) -----------------------------------------------
# Base URL used by Playwright + stress when hitting the running app.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
