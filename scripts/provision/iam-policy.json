{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAsAdmin",
      "Effect": "Allow",
      "Action": "dsql:DbConnectAdmin",
      "Resource": "arn:aws:dsql:*:*:cluster/*"
    },
    {
      "Sid": "ProvisionAndInspect",
      "Effect": "Allow",
      "Action": [
        "dsql:CreateCluster",
        "dsql:GetCluster",
        "dsql:UpdateCluster",
        "dsql:ListClusters",
        "dsql:TagResource",
        "dsql:DeleteCluster"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowDsqlServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/dsql.amazonaws.com/*",
      "Condition": {
        "StringLike": { "iam:AWSServiceName": "dsql.amazonaws.com" }
      }
    }
  ]
}
